    "detail": "stopped",
    "tempo": "idle",
    "tokens": 171,
    "template": "bg",
    "backend": "daemon",
    "nameSource": "auto",
    "daemonShort": "<8-hex-short-id>",
    "cliVersion": "2.1.306"
