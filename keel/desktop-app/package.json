{
  "name": "keel-desktop",
  "version": "0.1.1",
  "description": "Keel — local, private, multi-agent coding workspace",
  "author": {
    "name": "Keel Team"
  },
  "license": "Proprietary",
  "private": true,
  "homepage": "https://keel-desktop.vercel.app",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "app.keel.desktop",
    "productName": "Keel",
    "copyright": "Copyright © 2026 Keel Team",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "main.js",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "../site",
        "to": "site",
        "filter": [
          "**/*",
          "!**/.vercel/**",
          "!**/.git/**",
          "!README.md"
        ]
      },
      {
        "from": "../desktop/ui",
        "to": "desktop/ui",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../build/resources/keel",
        "to": "keel"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Keel-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Keel",
      "include": "build/nsis-keel.nsh",
      "installerHeader": "build/header.bmp",
      "installerSidebar": "build/sidebar.bmp",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "license": "build/LICENSE.txt"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        { "target": "pkg", "arch": ["arm64", "x64"] }
      ],
      "artifactName": "Keel-${version}-macos-${arch}.${ext}",
      "darkModeSupport": true
    },
    "pkg": {
      "installLocation": "/Applications",
      "isRelocatable": true,
      "isVersionChecked": true,
      "overwriteAction": "upgrade"
    },
    "linux": {
      "maintainer": "Keel Team",
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "build/icons",
      "description": "Keel - local, private, multi-agent coding workspace. Your agents, your files, your machine.",
      "artifactName": "Keel-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libasound2"
      ]
    },
    "npmRebuild": false,
    "electronDownload": {
      "cache": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  }
}
