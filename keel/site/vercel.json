{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://openrouter.ai https://generativelanguage.googleapis.com; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/download.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/product/overview", "destination": "/product-overview.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/new", "destination": "/new.html" },
    { "source": "/plugins", "destination": "/plugins.html" },
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/artifacts", "destination": "/artifacts.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/notices", "destination": "/notices.html" },
    { "source": "/roadmap", "destination": "/roadmap.html" },
    { "source": "/eula", "destination": "/eula.html" },
    { "source": "/trademark", "destination": "/trademark.html" },
    { "source": "/requirements", "destination": "/requirements.html" },
    { "source": "/product/keel-duet", "destination": "/product/keel-duet.html" },
    { "source": "/platform/api", "destination": "/platform/api.html" }
  ],
  "redirects": [
    { "source": "/app.html", "destination": "/app", "permanent": false },
    { "source": "/login.html", "destination": "/login", "permanent": false },
    { "source": "/new.html", "destination": "/new", "permanent": false },
    { "source": "/plugins.html", "destination": "/plugins", "permanent": false },
    { "source": "/projects.html", "destination": "/projects", "permanent": false },
    { "source": "/artifacts.html", "destination": "/artifacts", "permanent": false },
    { "source": "/product/keel-duet.html", "destination": "/product/keel-duet", "permanent": false },
    { "source": "/platform/api.html", "destination": "/platform/api", "permanent": false }
  ]
}
