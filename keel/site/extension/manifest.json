{
  "manifest_version": 3,
  "name": "Keel in Chrome",
  "version": "1.0.0",
  "description": "Ask Keel about the page you are on and turn it into structured work — a local-first, deterministic demo side panel.",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open Keel side panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "contextMenus",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
