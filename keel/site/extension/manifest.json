{
  "manifest_version": 3,
  "name": "Keel in Chrome",
  "short_name": "Keel",
  "version": "1.0.0",
  "description": "Read the web page you are on and turn it into a local summary or a structured brief. A private, deterministic demo side panel: no account, no API key, no network calls.",
  "homepage_url": "https://keel-desktop.vercel.app/keel-in-chrome",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open Keel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
